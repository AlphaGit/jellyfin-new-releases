<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Jellyfin.Plugin.NewReleases</RootNamespace>
    <Product>Jellyfin New Releases</Product>
    <Authors>Alpha</Authors>
    <Version>0.1.0.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed web UI pages (admin config page, user view fragment) as assembly resources. -->
    <EmbeddedResource Include="Web/*.html;Web/*.js;Web/*.css" />
    <!-- Numbered SQL migrations applied by Storage/Database.cs on first open. -->
    <EmbeddedResource Include="Storage/Migrations/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server runs Jellyfin 10.11.11 (net9.0). Keep package versions in lockstep with the server ABI. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- SQLite persistence. Exact pin (constitution VI); native libe_sqlite3 ships via build.yaml artifacts. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.19" />
  </ItemGroup>

</Project>
